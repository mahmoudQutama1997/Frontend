# Same-origin API path is recommended for local development.
VITE_API_URL=/api

# Optional: uncomment and change if Django uses another host or port.
# WASELNI_BACKEND_URL=http://127.0.0.1:8000

# Routing and reverse-geocoding providers (public demo endpoints are for development only).
VITE_OSRM_URL=https://router.project-osrm.org
VITE_GEOCODING_URL=https://nominatim.openstreetmap.org/reverse

# Replace the default tile endpoint with a contracted provider for production.
VITE_MAP_TILE_URL=https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png
VITE_MAP_ATTRIBUTION=&copy; OpenStreetMap &copy; CARTO
